{
    "single-device-simulation": 1,
    "scheduling-policy": "LIFO",
    "endpoint-delay": 10,
    "active-chunks-per-dimension": 1,
    "preferred-dataset-splits": 4,
    "all-reduce-implementation": ["ring", "ring", "ring", "ring"],
    "all-gather-implementation": ["ring", "ring", "ring", "ring"],
    "reduce-scatter-implementation": ["ring", "ring", "ring", "ring"],
    "all-to-all-implementation": ["ring", "ring", "ring", "ring"],
    "collective-optimization": "localBWAware",
    "local-mem-bw": 1200,
    "boost-mode": 0,
    "roofline-enabled": true,
    "peak-perf": 500
}
